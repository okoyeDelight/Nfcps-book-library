# Configure these in Netlify Site configuration > Environment variables.
# Never commit real secret values to GitHub.
ADMIN_PASSWORD=replace-with-admin-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
GITHUB_LIBRARY_TOKEN=replace-with-a-fine-grained-github-token
GITHUB_LIBRARY_REPO=okoyeDelight/Nfcps-book-library
GITHUB_LIBRARY_BRANCH=main
